  "content": "\u003cdiv class=\"field field-name-field-government\"\u003e\u003cdiv class=\"taxonomy-term taxonomy-term--type-government taxonomy-term--view-mode-strapline ds-1col clearfix\"\u003e\n\n  \n\n      \n      \u003cem class=\"archive-indicator\"\u003e\u003c/em\u003e\n      \n  \n\n\n\n\u003c/div\u003e\n\n\u003c/div\u003e\n    \n      \u003ctime class=\"meta meta__date\" datetime=\"\"\u003e\u003ctime datetime=\"2025-04-22T20:44:48Z\"\u003e23 April 2025\u003c/time\u003e\n\u003c/time\u003e\n      \n  \n\n\n  \u003ch1 class=\"article__title\"\u003e\n  Prime Minister to attend Pope Francis’ funeral \n\u003c/h1\u003e\n\n    \n            \u003cul class=\"meta--ministers\"\u003e\n            \u003cli\u003e\u003cdiv class=\"teaser--small minister taxonomy-term taxonomy-term--type-ministers taxonomy-term--view-mode-teaser-small ds-1col clearfix\"\u003e\n\n  \n\n  \u003ca href=\"/minister/rt-hon-christopher-luxon\" class=\"field-group-link minister__link\" hreflang=\"en\"\u003e    \n      \u003cdiv class=\"field minister__portrait\"\u003e\u003cdiv\u003e\n  \n  \n            \u003cdiv class=\"field field--name-field-media-image field--type-image field--label-hidden field--item\"\u003e  \u003cimg loading=\"lazy\" src=\"/sites/default/files/styles/thumbnail/public/2023-12/Luxon_1.jpg?itok=B3eNyDRQ\" width=\"100\" height=\"100\" alt=\"Christopher Luxon portrait\" class=\"img-responsive\"/\u003e\n\n\n\u003c/div\u003e\n      \n\u003c/div\u003e\n\u003c/div\u003e\n      \n  \n\n    \n      \u003cdiv class=\"field minister__title\"\u003e  Rt Hon Christopher Luxon\n\u003c/div\u003e\n      \n  \n\n\u003c/a\u003e\n\n\u003c/div\u003e\n\n\u003c/li\u003e\n      \n      \u003c/ul\u003e\n  \n\n    \n      \u003cem class=\"tag tag--portfolio\"\u003e\u003cdiv class=\"tag taxonomy-term taxonomy-term--type-portfolios taxonomy-term--view-mode-teaser-small ds-1col clearfix\"\u003e\n\n  \n\n  \n    \u003ca href=\"/portfolio/nationalactnew-zealand-first-coalition-government-2023-2026/prime-